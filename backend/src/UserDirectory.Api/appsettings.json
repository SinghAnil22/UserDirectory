{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Data Source=/data/app.db"
  },
  "Auth": {
    "Authority": "https://accounts.google.com",
    "Audience": ""
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000", "http://localhost:5173", "http://localhost:5174" ]
  },
  "Seed": {
    "Enabled": true
  },
  "Swagger": {
    "Enabled": true
  }
}
